{
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 30
    }
  },
  "routes": [
    {
      "src": "/build/(.*)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "dest": "/build/$1"
    },
    {
      "src": "/(css|js|fonts|vendor|images|assets|storage|favicon\\.ico|robots\\.txt)(.*)",
      "dest": "/$1$2"
    },
    {
      "src": "/(ABCDips_Treats_Test_Case_Suite\\.pdf)",
      "dest": "/$1"
    },
    {
      "src": "/(.*)\\.php$",
      "dest": "/api/index.php"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "env": {
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "APP_URL": "https://abc-dips-and-treats.vercel.app",
    "APP_CONFIG_CACHE": "/tmp/config.php",
    "APP_EVENTS_CACHE": "/tmp/events.php",
    "APP_PACKAGES_CACHE": "/tmp/packages.php",
    "APP_ROUTES_CACHE": "/tmp/routes.php",
    "APP_SERVICES_CACHE": "/tmp/services.php",
    "VIEW_COMPILED_PATH": "/tmp/storage/framework/views",
    "LARAVEL_STORAGE_PATH": "/tmp/storage",
    "CACHE_STORE": "array",
    "SESSION_DRIVER": "cookie",
    "LOG_CHANNEL": "stderr",
    "DB_CONNECTION": "sqlite",
    "TRUST_PROXIES": "*",
    "VERCEL": "1"
  }
}
